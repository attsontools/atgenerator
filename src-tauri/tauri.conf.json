{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "生成器",
  "version": "0.1.0-alpha.0",
  "identifier": "com.attson.generator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1423",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "生成器",
        "width": 1120,
        "height": 760,
        "minWidth": 680,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "nsis"]
  },
  "plugins": {}
}
